# Copie para .env (ou rode `make env`, que gera as chaves locais automaticamente).
# Nunca commite o .env.

# --- Clinic API -------------------------------------------------------------
# Chave exigida no header X-API-Key. Gere com: openssl rand -hex 24
CLINIC_API_KEY=
CLINIC_TIMEZONE=America/Sao_Paulo
# Opcional: cria um paciente com um e-mail real seu no seed, para receber as confirmações.
DEMO_PATIENT_EMAIL=
DEMO_PATIENT_NAME=Paciente Demo

# --- n8n --------------------------------------------------------------------
# Criptografa as credenciais salvas no n8n. Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Sao_Paulo

# --- OpenAI (LLM do agente, transcrição e TTS) ------------------------------
OPENAI_API_KEY=

# --- Google OAuth2 (Gmail API) ----------------------------------------------
# Redirect URI a cadastrar no Google Cloud: http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
