        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#1f2937;line-height:1.5\"><h2 style=\"color:#b91c1c;margin:0 0 12px\">Consulta cancelada</h2><p>Olá, {{ $('Cancel appointment').item.json.body.patient.full_name }}!</p><p>Confirmamos o cancelamento da consulta abaixo:</p><table style=\"border-collapse:collapse;width:100%;border-top:1px solid #e5e7eb\"><tr><td style=\"padding:8px 0;color:#6b7280;width:130px\">Especialidade</td><td style=\"padding:8px 0\"><strong>{{ $('Cancel appointment').item.json.body.doctor.specialty }}</strong></td></tr><tr><td style=\"padding:8px 0;color:#6b7280;width:130px\">Profissional</td><td style=\"padding:8px 0\"><strong>{{ $('Cancel appointment').item.json.body.doctor.full_name }}</strong></td></tr><tr><td style=\"padding:8px 0;color:#6b7280;width:130px\">Data</td><td style=\"padding:8px 0\"><strong>{{ $('Cancel appointment').item.json.body.weekday_name }}, {{ DateTime.fromISO($('Cancel appointment').item.json.body.starts_at, { setZone: true }).toFormat('dd/LL/yyyy') }}</strong></td></tr><tr><td style=\"padding:8px 0;color:#6b7280;width:130px\">Horário</td><td style=\"padding:8px 0\"><strong>{{ DateTime.fromISO($('Cancel appointment').item.json.body.starts_at, { setZone: true }).toFormat('HH:mm') }}</strong></td></tr><tr><td style=\"padding:8px 0;color:#6b7280;width:130px\">Valor</td><td style=\"padding:8px 0\"><strong>{{ $('Cancel appointment').item.json.body.price.formatted }}</strong></td></tr><tr><td style=\"padding:8px 0;color:#6b7280;width:130px\">Protocolo</td><td style=\"padding:8px 0\"><strong>#{{ $('Cancel appointment').item.json.body.id }}</strong></td></tr></table><p style=\"margin-top:16px\">Quando quiser remarcar, é só falar com a nossa assistente virtual.</p><hr style=\"border:none;border-top:1px solid #e5e7eb;margin:24px 0 12px\"><p style=\"font-size:12px;color:#6b7280\">{{ $json.name }} · {{ $json.address }} · {{ $json.phone }}<br>Mensagem automática enviada pela assistente virtual da clínica.</p></div>",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $json.name }}"
        }
      },
