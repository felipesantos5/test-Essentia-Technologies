              "name": "appointment_id",
              "type": "number"
            },
            {
              "name": "patient_email",
              "type": "string"
            },
            {
              "name": "reason",
              "type": "string"
            }
          ]
        }
      },
      "id": "770d5c8b-a177-5833-afff-2b4a6acd0620",
      "name": "When called by the agent",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
