    {
      "parameters": {
        "sendTo": "felipesantosmarcelino2004@gmail.com",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html lang=\"pt-BR\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<meta name=\"format-detection\" content=\"telephone=no, date=no, address=no, email=no\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>{{ $json.subject }}</title>\n<!--[if mso]>\n<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>\n<style>table, td, p, a, h1 { font-family: Arial, Helvetica, sans-serif !important; }</style>\n<![endif]-->\n<style>\n  body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\n  img { -ms-interpolation-mode: bicubic; }\n  a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }\n\n  @media only screen and (max-width: 620px) {\n    .email-container { width: 100% !important; }\n    .email-px { padding-left: 24px !important; padding-right: 24px !important; }\n    .email-title { font-size: 24px !important; line-height: 32px !important; }\n    .email-stack { display: block !important; width: 100% !important; padding-left: 0 !important; padding-right: 0 !important; }\n    .email-stack-gap { padding-top: 12px !important; }\n    .email-label { width: 104px !important; }\n  }\n</style>\n</head>\n<body style=\"margin: 0; padding: 0; width: 100%; background-color: #eef3f2;\">\n\n<!-- Preheader: shown next to the subject in the inbox, hidden inside the message. -->\n<div style=\"display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #eef3f2; opacity: 0;\">\n  {{ $json.preheader }}\n  &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;\n  &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;\n  &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;\n</div>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#eef3f2\" style=\"background-color: #eef3f2;\">\n  <tr>\n    <td align=\"center\" style=\"padding: 32px 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #16302b;\">\n      <!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\"><tr><td><![endif]-->\n      <table role=\"presentation\" class=\"email-container\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width: 100%; max-width: 600px;\">\n\n        <!-- Card -->\n        <tr>\n          <td bgcolor=\"#ffffff\" style=\"background-color: #ffffff; border: 1px solid #d8e3e0; border-radius: 16px;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n\n              <!-- Header -->\n              <tr>\n                <td align=\"center\" bgcolor=\"#0b5c56\" style=\"background-color: #0b5c56; background-image: linear-gradient(135deg, #083f3b 0%, #0f766e 100%); border-radius: 15px 15px 0 0; padding: 36px 24px 32px;\">\n                  <img src=\"https://raw.githubusercontent.com/felipesantos5/test-Essentia-Technologies/main/n8n/email-templates/assets/logo-essentia.png\" width=\"180\" height=\"108\" alt=\"{{ $json.clinic_name }}\" style=\"display: block; width: 180px; max-width: 180px; height: auto; border: 0; outline: none; text-decoration: none; color: #ffffff; font-size: 20px; font-weight: 700; line-height: 28px;\">\n                </td>\n              </tr>\n\n              <!-- Intro -->\n              <tr>\n                <td class=\"email-px\" style=\"padding: 40px 48px 0;\">\n                  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                    <tr>\n                      <td bgcolor=\"#fdecea\" style=\"background-color: #fdecea; border-radius: 999px; padding: 6px 14px; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: #b42318;\">&#10005;&nbsp; Consulta cancelada</td>\n                    </tr>\n                  </table>\n                  <h1 class=\"email-title\" style=\"margin: 20px 0 0; font-size: 28px; line-height: 36px; font-weight: 700; color: #16302b;\">Cancelamento confirmado</h1>\n                  <p style=\"margin: 12px 0 0; font-size: 16px; line-height: 26px; color: #5c706b;\">Olá, {{ $json.patient_first_name }}. A sua consulta de <strong style=\"color: #16302b;\">{{ $json.specialty }}</strong> foi cancelada e o horário já está livre para outros pacientes.</p>\n                </td>\n              </tr>\n\n              <!-- When -->\n              <tr>\n                <td class=\"email-px\" style=\"padding: 28px 48px 0;\">\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#f5f8f7\" style=\"background-color: #f5f8f7; border: 1px solid #d8e3e0; border-radius: 12px;\">\n                    <tr>\n                      <td width=\"64\" valign=\"top\" style=\"padding: 20px 0 20px 20px;\">\n                        <table role=\"presentation\" width=\"64\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#ffffff\" style=\"background-color: #ffffff; border: 1px solid #d8e3e0; border-radius: 10px;\">\n                          <tr>\n                            <td align=\"center\" bgcolor=\"#8a9b97\" style=\"background-color: #8a9b97; border-radius: 9px 9px 0 0; padding: 4px 0; font-size: 11px; line-height: 14px; font-weight: 700; letter-spacing: 1px; color: #ffffff;\">{{ $json.month_short }}</td>\n                          </tr>\n                          <tr>\n                            <td align=\"center\" style=\"padding: 6px 0 0; font-size: 26px; line-height: 30px; font-weight: 700; color: #8a9b97;\">{{ $json.day }}</td>\n                          </tr>\n                          <tr>\n                            <td align=\"center\" style=\"padding: 0 0 8px; font-size: 11px; line-height: 14px; font-weight: 600; letter-spacing: 0.5px; color: #8a9b97;\">{{ $json.weekday_short }}</td>\n                          </tr>\n                        </table>\n                      </td>\n                      <td valign=\"middle\" style=\"padding: 20px 20px 20px 16px;\">\n                        <p style=\"margin: 0; font-size: 17px; line-height: 24px; font-weight: 700; color: #5c706b; text-decoration: line-through;\">{{ $json.date_long }}</p>\n                        <p style=\"margin: 4px 0 0; font-size: 16px; line-height: 24px; font-weight: 600; color: #8a9b97; text-decoration: line-through;\">{{ $json.time_range }}</p>\n                        <p style=\"margin: 4px 0 0; font-size: 14px; line-height: 22px; color: #5c706b;\">{{ $json.doctor_name }} &middot; {{ $json.specialty }}</p>\n                      </td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n\n              <!-- Details -->\n              <tr>\n                <td class=\"email-px\" style=\"padding: 32px 48px 0;\">\n                  <p style=\"margin: 0 0 4px; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: #5c706b;\">Detalhes do cancelamento</p>\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size: 15px; line-height: 22px;\">\n                    <tr>\n                      <td class=\"email-label\" width=\"136\" valign=\"top\" style=\"padding: 12px 12px 12px 0; border-bottom: 1px solid #e6eeec; color: #5c706b;\">Paciente</td>\n                      <td valign=\"top\" style=\"padding: 12px 0; border-bottom: 1px solid #e6eeec; font-weight: 600; color: #16302b;\">{{ $json.patient_name }}</td>\n                    </tr>\n                    <tr>\n                      <td class=\"email-label\" width=\"136\" valign=\"top\" style=\"padding: 12px 12px 12px 0; border-bottom: 1px solid #e6eeec; color: #5c706b;\">Protocolo</td>\n                      <td valign=\"top\" style=\"padding: 12px 0; border-bottom: 1px solid #e6eeec; font-weight: 600; color: #16302b;\">{{ $json.protocol }}</td>\n                    </tr>\n                    <tr>\n                      <td class=\"email-label\" width=\"136\" valign=\"top\" style=\"padding: 12px 12px 12px 0; color: #5c706b;\">Cancelada em</td>\n                      <td valign=\"top\" style=\"padding: 12px 0; font-weight: 600; color: #16302b;\">{{ $json.cancelled_at }}</td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n\n              <!-- Reschedule -->\n              <tr>\n                <td class=\"email-px\" style=\"padding: 32px 48px 40px;\">\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#f5f8f7\" style=\"background-color: #f5f8f7; border-left: 4px solid #0f766e; border-radius: 12px;\">\n                    <tr>\n                      <td style=\"padding: 24px;\">\n                        <p style=\"margin: 0; font-size: 16px; line-height: 24px; font-weight: 700; color: #16302b;\">Quer remarcar?</p>\n                        <p style=\"margin: 8px 0 0; font-size: 15px; line-height: 24px; color: #5c706b;\">É só falar com a nossa <strong style=\"color: #16302b;\">assistente virtual</strong>, por texto ou áudio. Ela mostra os horários livres e agenda a nova consulta para você.</p>\n                        <p style=\"margin: 12px 0 0; font-size: 15px; line-height: 24px; color: #5c706b;\">Prefere ligar? <a href=\"{{ $json.clinic_phone_href }}\" style=\"color: #0f766e; font-weight: 700; text-decoration: none;\">{{ $json.clinic_phone }}</a></p>\n                      </td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n\n            </table>\n          </td>\n        </tr>\n\n        <!-- Footer -->\n        <tr>\n          <td align=\"center\" class=\"email-px\" style=\"padding: 28px 40px 8px; font-size: 12px; line-height: 20px; color: #5c706b;\">\n            <p style=\"margin: 0; font-size: 13px; font-weight: 700; color: #16302b;\">{{ $json.clinic_name }}</p>\n            <p style=\"margin: 4px 0 0;\">{{ $json.clinic_address }}</p>\n            <p style=\"margin: 4px 0 0;\">\n              <a href=\"{{ $json.clinic_phone_href }}\" style=\"color: #0f766e; text-decoration: none;\">{{ $json.clinic_phone }}</a>\n              &nbsp;&middot;&nbsp;\n              <a href=\"mailto:{{ $json.clinic_email }}\" style=\"color: #0f766e; text-decoration: none;\">{{ $json.clinic_email }}</a>\n            </p>\n            <p style=\"margin: 16px 0 0; color: #7d8f8b;\">Mensagem automática enviada pela assistente virtual da clínica.</p>\n          </td>\n        </tr>\n\n      </table>\n      <!--[if mso]></td></tr></table><![endif]-->\n    </td>\n  </tr>\n</table>\n\n</body>\n</html>\n",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $json.clinic_name }}"
        }
      },
