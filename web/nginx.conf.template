# Rendered by the nginx image's envsubst step: only ${CLINIC_API_KEY} is substituted
# (NGINX_ENVSUBST_FILTER in docker-compose.yml), nginx's own $variables are left as they are.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's DNS, re-resolved every 10 s: proxy_pass targets are variables below so a rebuilt
    # api or n8n container (new IP) keeps working without restarting nginx.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $n8n_upstream http://n8n:5678;
    set $api_upstream http://api:8000;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # add_header is not inherited by a location that sets its own headers, so every header
    # lives here and the locations below add none.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # The pages are self-contained; blob: covers recorded and received audio, data: the inline icons.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'" always;
    # No build step and no hashed filenames: revalidate so testers never see a stale UI after edits.
    add_header Cache-Control "no-cache" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin proxy to the n8n production webhooks: the chat page needs no CORS.
    location /webhook/ {
        proxy_pass $n8n_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;       # OpenAI transcription limit
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;        # agent + tools + TTS can take a while
    }

    # Appointments panel: read-only access to two listing routes. nginx adds the API key,
    # so it never reaches the browser, and every other method or route stays blocked.
    location /api/ {
        return 404;
    }

    location = /api/v1/appointments {
        limit_except GET { deny all; }
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "${CLINIC_API_KEY}";
    }

    location = /api/v1/doctors {
        limit_except GET { deny all; }
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "${CLINIC_API_KEY}";
    }
}
