                ]
              }
            }
          ]
        },
        {
          "name": "Buscar consulta passada (seed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/patients?email=luiza.fernandes@example.com",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "patients"
