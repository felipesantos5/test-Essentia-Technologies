                  "  url: pm.variables.replaceIn(`{{api_base_url}}/patients/${patient.id}/appointments?upcoming=false`),",
                  "  header: { 'X-API-Key': pm.variables.get('api_key') },",
                  "}, (err, res) => pm.collectionVariables.set('past_appointment_id', res.json()[0].id));"
                ]
