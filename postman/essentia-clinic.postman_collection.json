      "name": "3. API – regras de negócio e erros",
      "item": [
        {
          "name": "401 – API key inválida",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "chave-errada"
              }
            ],
            "url": {
              "raw": "{{api_base_url}}/specialties",
